'use client';

import React, { useEffect, useMemo, useRef, useState } from 'react';
import { useSpring, animated } from '@react-spring/three';
import { Text } from '@react-three/drei';
import * as THREE from 'three';
import { BookCategory } from '@/types/portfolio';
import { usePortfolioStore } from '@/store/usePortfolioStore';

interface BookMesh3DProps {
  book: BookCategory;
  index: number;
  totalBooks: number;
}

function createPagesTexture(): THREE.CanvasTexture {
  const canvas = document.createElement('canvas');
  canvas.width = 512;
  canvas.height = 512;
  const ctx = canvas.getContext('2d');
  if (ctx) {
    ctx.fillStyle = '#F4EFE4';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    for (let y = 0; y < canvas.height; y += 2) {
      const wave = Math.sin(y * 0.45) * 0.03;
      const baseAlpha = y % 4 === 0 ? 0.14 : 0.06;
      ctx.fillStyle = `rgba(38, 32, 24, ${Math.max(0.02, baseAlpha + wave)})`;
      ctx.fillRect(0, y, canvas.width, 1);
    }
  }
  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.wrapS = THREE.RepeatWrapping;
  texture.wrapT = THREE.RepeatWrapping;
  texture.repeat.set(2, 2);
  texture.needsUpdate = true;
  return texture;
}

function createContactShadowTexture(): THREE.CanvasTexture {
  const canvas = document.createElement('canvas');
  canvas.width = 256;
  canvas.height = 256;
  const ctx = canvas.getContext('2d');
  if (ctx) {
    const grad = ctx.createRadialGradient(128, 128, 16, 128, 128, 120);
    grad.addColorStop(0, 'rgba(0, 0, 0, 0.52)');
    grad.addColorStop(0.55, 'rgba(0, 0, 0, 0.22)');
    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 256, 256);
  }
  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.needsUpdate = true;
  return texture;
}

function createConvexSpineGeometry(thickness: number, height: number, curveDepth: number): THREE.BufferGeometry {
  const segX = 32;
  const segY = 2;
  const halfT = thickness / 2;
  const halfH = height / 2;

  const positions: number[] = [];
  const uvs: number[] = [];
  const indices: number[] = [];

  for (let iy = 0; iy <= segY; iy++) {
    const v = iy / segY;
    const y = -halfH + v * height;

    for (let ix = 0; ix <= segX; ix++) {
      const u = ix / segX;
      const nx = u * 2 - 1;
      const x = nx * halfT;
      const dome = Math.cos(nx * (Math.PI / 2));
      const hingePinch = Math.pow(Math.abs(nx), 4) * (curveDepth * 0.25);
      const z = Math.pow(dome, 0.85) * curveDepth - hingePinch;

      positions.push(x, y, z);
      uvs.push(u, v);
    }
  }

  const rowStride = segX + 1;
  for (let iy = 0; iy < segY; iy++) {
    for (let ix = 0; ix < segX; ix++) {
      const a = iy * rowStride + ix;
      const b = a + 1;
      const c = (iy + 1) * rowStride + ix;
      const d = c + 1;

      indices.push(a, b, d);
      indices.push(a, d, c);
    }
  }

  const geom = new THREE.BufferGeometry();
  geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
  geom.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
  geom.setIndex(indices);
  geom.computeVertexNormals();
  return geom;
}

function addPaperGrain(ctx: CanvasRenderingContext2D, w: number, h: number, alpha = 0.035) {
  ctx.save();
  for (let i = 0; i < 4500; i++) {
    const x = Math.random() * w;
    const y = Math.random() * h;
    ctx.fillStyle = i % 2 === 0 ? `rgba(0,0,0,${alpha})` : `rgba(255,255,255,${alpha})`;
    ctx.fillRect(x, y, 1.5, 1.5);
  }
  ctx.restore();
}

function createCoverTexture(bookId: string, baseColor: string, accentColor: string): THREE.CanvasTexture {
  const canvas = document.createElement('canvas');
  const w = 720;
  const h = 1024;
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');

  if (ctx) {
    ctx.fillStyle = baseColor;
    ctx.fillRect(0, 0, w, h);

    const spineGrad = ctx.createLinearGradient(0, 0, 44, 0);
    spineGrad.addColorStop(0, 'rgba(0,0,0,0.24)');
    spineGrad.addColorStop(0.5, 'rgba(255,255,255,0.07)');
    spineGrad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = spineGrad;
    ctx.fillRect(0, 0, 44, h);

    ctx.save();

    if (bookId === 'book-motion') {
      ctx.strokeStyle = 'rgba(17, 17, 17, 0.14)';
      ctx.lineWidth = 2;
      for (let r = 80; r <= 340; r += 36) {
        ctx.beginPath();
        ctx.arc(w * 0.5, h * 0.44, r, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.strokeStyle = '#2563EB';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(72, h * 0.72);
      ctx.bezierCurveTo(w * 0.35, h * 0.18, w * 0.65, h * 0.75, w - 72, h * 0.24);
      ctx.stroke();

      const points = [
        [72, h * 0.72],
        [w * 0.5, h * 0.46],
        [w - 72, h * 0.24],
      ];
      points.forEach(([px, py]) => {
        ctx.save();
        ctx.translate(px, py);
        ctx.rotate(Math.PI / 4);
        ctx.fillStyle = '#111111';
        ctx.fillRect(-8, -8, 16, 16);
        ctx.restore();
      });

      ctx.fillStyle = '#111111';
      ctx.fillRect(56, 56, w - 112, 3);
      ctx.fillRect(56, h - 76, w - 112, 2);

      ctx.font = '600 18px sans-serif';
      ctx.fillStyle = '#111111';
      ctx.fillText('VOL. 01 — MOTION GRAPHIC · 2D&3D · TITLE SEQUENCE', 56, 92);
      ctx.fillText('24 FPS', w - 125, 92);
    } else if (bookId === 'book-brand') {
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.32)';
      ctx.lineWidth = 2;
      ctx.strokeRect(54, 64, w - 108, h - 128);

      ctx.save();
      ctx.beginPath();
      ctx.rect(54, h * 0.44, w - 108, h * 0.38);
      ctx.clip();

      ctx.fillStyle = 'rgba(255, 255, 255, 0.12)';
      for (let x = -200; x < w + 300; x += 54) {
        ctx.beginPath();
        ctx.moveTo(x, h * 0.44);
        ctx.lineTo(x + 24, h * 0.44);
        ctx.lineTo(x - 120, h * 0.85);
        ctx.lineTo(x - 144, h * 0.85);
        ctx.closePath();
        ctx.fill();
      }
      ctx.restore();

      ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
      ctx.fillRect(84, h * 0.44, w - 168, 2);

      ctx.fillStyle = '#FFFFFF';
      ctx.font = '700 18px sans-serif';
      ctx.fillText('CAMPAIGN SERIES · 02', 84, 108);
      ctx.fillText('BRAND / KEY VISUAL', w - 285, 108);
      ctx.font = '600 16px sans-serif';
      ctx.fillText('DIRECTION & SYSTEM', 84, h - 92);
    } else if (bookId === 'book-character') {
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
      ctx.lineWidth = 1.5;
      for (let x = 60; x < w; x += 60) {
        ctx.beginPath();
        ctx.moveTo(x, 60);
        ctx.lineTo(x, h - 60);
        ctx.stroke();
      }
      for (let y = 60; y < h; y += 60) {
        ctx.beginPath();
        ctx.moveTo(60, y);
        ctx.lineTo(w - 60, y);
        ctx.stroke();
      }

      ctx.strokeStyle = '#A3E635';
      ctx.lineWidth = 3;
      ctx.strokeRect(110, 160, w - 220, 440);

      ctx.strokeStyle = 'rgba(163, 230, 53, 0.45)';
      ctx.setLineDash([8, 8]);
      ctx.beginPath();
      ctx.moveTo(w / 2, 160);
      ctx.lineTo(w / 2, 600);
      ctx.moveTo(110, 340);
      ctx.lineTo(w - 110, 340);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = 'rgba(255, 255, 255, 0.12)';
      ctx.beginPath();
      ctx.arc(w / 2, 290, 68, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.roundRect(w / 2 - 85, 375, 170, 175, 50);
      ctx.fill();

      ctx.fillStyle = '#A3E635';
      ctx.font = '700 18px monospace';
      ctx.fillText('FIG. 03 — CHARACTER SHEET', 110, 138);
      ctx.fillText('SCALE 1:1', w - 210, 138);
    } else if (bookId === 'book-artwork') {
      ctx.strokeStyle = '#1A1A1A';
      ctx.lineWidth = 3;
      ctx.strokeRect(52, 52, w - 104, h - 104);
      ctx.lineWidth = 1;
      ctx.strokeRect(64, 64, w - 128, h - 128);

      ctx.fillStyle = '#F97316';
      ctx.beginPath();
      ctx.arc(w * 0.5, h * 0.58, 135, Math.PI, 0);
      ctx.fill();

      ctx.fillStyle = '#1A1A1A';
      ctx.beginPath();
      ctx.arc(w * 0.5, h * 0.58, 135, 0, Math.PI);
      ctx.fill();

      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      ctx.arc(w * 0.5 - 45, h * 0.58, 28, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#1A1A1A';
      ctx.font = '600 17px serif';
      ctx.fillText('EXHIBITION MONOGRAPH — NO. 04', 90, 108);
    } else if (bookId === 'book-side') {
      ctx.fillStyle = 'rgba(31, 41, 55, 0.22)';
      for (let x = 56; x <= w - 56; x += 32) {
        for (let y = 56; y <= h - 56; y += 32) {
          ctx.beginPath();
          ctx.arc(x, y, 2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.fillStyle = '#1F2937';
      ctx.fillRect(56, 56, 210, 44);
      ctx.fillStyle = '#FAF3B6';
      ctx.font = '700 19px monospace';
      ctx.fillText('LAB NOTE #05', 74, 85);

      ctx.save();
      ctx.translate(w * 0.5, h * 0.63);
      ctx.rotate(-0.06);
      ctx.strokeStyle = '#1F2937';
      ctx.lineWidth = 3;
      ctx.strokeRect(-190, -55, 380, 110);
      ctx.fillStyle = 'rgba(31, 41, 55, 0.08)';
      ctx.fillRect(-190, -55, 380, 110);
      ctx.fillStyle = '#1F2937';
      ctx.font = '700 20px monospace';
      ctx.fillText('PROTOTYPES & EXPERIMENTS', -158, 7);
      ctx.restore();
    }

    ctx.restore();
    addPaperGrain(ctx, w, h, 0.04);
  }

  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.anisotropy = 8;
  texture.needsUpdate = true;
  return texture;
}

export default function BookMesh3D({ book, index, totalBooks }: BookMesh3DProps) {
  const groupRef = useRef<THREE.Group>(null);
  const openTimerRef = useRef<number | null>(null);
  const [isLocalHover, setIsLocalHover] = useState(false);

  const hoveredIndex = usePortfolioStore((state) => state.hoveredBookIndex);
  const setHoveredBookIndex = usePortfolioStore((state) => state.setHoveredBookIndex);
  const openBook = usePortfolioStore((state) => state.openBook);
  const selectedBookId = usePortfolioStore((state) => state.selectedBookId);

  const isHovered = hoveredIndex === index;
  const hasAnyHover = hoveredIndex !== null;

  useEffect(() => {
    return () => {
      if (openTimerRef.current !== null) {
        window.clearTimeout(openTimerRef.current);
      }
    };
  }, []);

  useEffect(() => {
    if (selectedBookId === null && openTimerRef.current !== null) {
      window.clearTimeout(openTimerRef.current);
      openTimerRef.current = null;
    }
  }, [selectedBookId]);

  const baseSpacing = 0.55;
  const centerOffset = ((totalBooks - 1) * baseSpacing) / 2;
  const baseX =
    index * baseSpacing -
    centerOffset +
    (book.id === 'book-brand' ? 0.08 : 0) +
    (index === 4 ? 0.24 : 0);

  let targetX = baseX;
  if (hasAnyHover && hoveredIndex !== null && !isHovered) {
    const spreadAmount = 1.55;
    if (index < hoveredIndex) {
      targetX = baseX - spreadAmount;
    } else if (index > hoveredIndex) {
      targetX = baseX + spreadAmount;
    }
  }

  const bookHeight = book.height || 3.7;
  const bookThickness = book.thickness || 0.55;
  const bookWidth = 2.7;
  const baseY = bookHeight / 2;
  const restingTiltZ = book.tiltAngle || 0;

  const spineBulge = Math.min(0.085, bookThickness * 0.14);
  const spineGeometry = useMemo(
    () => createConvexSpineGeometry(bookThickness, bookHeight, spineBulge),
    [bookThickness, bookHeight, spineBulge]
  );

  const pagesTexture = useMemo(() => createPagesTexture(), []);
  const shadowTexture = useMemo(() => createContactShadowTexture(), []);
  const coverTexture = useMemo(
    () => createCoverTexture(book.id, book.color, book.accentColor),
    [book.id, book.color, book.accentColor]
  );

  const coverBoardThickness = 0.024;
  const bodyDepth = bookWidth - spineBulge * 0.5;
  const bodyCenterZ = -spineBulge * 0.25;
  const spineBaseZ = bodyCenterZ + bodyDepth / 2 - 0.002;
  const spineLabelZ = spineBaseZ + spineBulge + 0.024;

  const innerPageThickness = Math.max(0.06, bookThickness - coverBoardThickness * 1.8);
  const innerPageHeight = Math.max(0.4, bookHeight - coverBoardThickness * 1.8);
  const innerPageWidth = Math.max(0.4, bodyDepth - coverBoardThickness * 1.2);

  const springProps = useSpring({
    position: [
      targetX,
      isHovered ? baseY + 0.22 : baseY,
      isHovered ? 2.0 : 0,
    ] as [number, number, number],
    rotation: [
      0,
      isHovered ? -Math.PI / 2 : 0,
      isHovered ? 0 : restingTiltZ,
    ] as [number, number, number],
    scale: isHovered ? 1.08 : 1,
    config: {
      mass: 1.2,
      tension: 150,
      friction: 22,
      duration: 600,
    },
  });

  const handlePointerOver = (e: { stopPropagation: () => void; pointerType?: string }) => {
    e.stopPropagation();
    if (e.pointerType === 'touch') return;
    setIsLocalHover(true);
    setHoveredBookIndex(index);
    document.body.style.cursor = 'pointer';
  };

  const handlePointerOut = (e: { stopPropagation: () => void; pointerType?: string }) => {
    e.stopPropagation();
    if (e.pointerType === 'touch') return;
    setIsLocalHover(false);
    if (hoveredIndex === index) {
      setHoveredBookIndex(null);
    }
    document.body.style.cursor = 'auto';
  };

  const handleClick = (e: { stopPropagation: () => void; pointerType?: string }) => {
    e.stopPropagation();
    document.body.style.cursor = 'auto';

    if (openTimerRef.current !== null) {
      window.clearTimeout(openTimerRef.current);
      openTimerRef.current = null;
    }

    const isMobileViewport =
      e.pointerType === 'touch' ||
      (typeof window !== 'undefined' && window.innerWidth < 768);

    if (isMobileViewport) {
      // 1단계: PC 호버와 동일한 펼쳐짐/회전 모션을 먼저 실행
      setHoveredBookIndex(index);
      // 2단계: 책이 스르륵 회전하며 보이는 모션이 진행된 뒤 포트폴리오 팝업 오픈
      openTimerRef.current = window.setTimeout(() => {
        openBook(book.id);
        openTimerRef.current = null;
      }, 650);
      return;
    }

    openBook(book.id);
  };

  const isCharacterBook = book.id === 'book-character';
  const spineFontSize = book.fontStyle === 'serif' ? 0.25 : 0.18;
  const spineTextY = isCharacterBook ? -bookHeight / 2 + 1.15 : 0;
  const spineMaxWidth = isCharacterBook ? bookHeight * 0.55 : bookHeight - 0.7;

  const coverTitleY =
    book.id === 'book-brand'
      ? 0.85
      : book.id === 'book-artwork'
        ? 0.88
        : book.id === 'book-side'
          ? 0.62
          : book.id === 'book-character'
            ? -0.92
            : 0.42;

  const coverSubtitleY =
    book.id === 'book-brand'
      ? 0.42
      : book.id === 'book-artwork'
        ? 0.46
        : book.id === 'book-side'
          ? 0.18
          : book.id === 'book-character'
            ? -1.28
            : -0.98;

  return (
    <group>
      <mesh
        position={[targetX, 0.004, 0.15]}
        rotation={[-Math.PI / 2, 0, restingTiltZ]}
      >
        <planeGeometry args={[bookThickness * 2.8, bookWidth * 1.35]} />
        <meshBasicMaterial
          map={shadowTexture}
          transparent
          opacity={0.72}
          depthWrite={false}
        />
      </mesh>

      <animated.group
        ref={groupRef}
        position={springProps.position}
        rotation={springProps.rotation}
        scale={springProps.scale}
        onPointerOver={handlePointerOver}
        onPointerOut={handlePointerOut}
        onClick={handleClick}
      >
        <mesh
          position={[bookThickness / 2 - coverBoardThickness / 2, 0, bodyCenterZ]}
          castShadow
          receiveShadow
        >
          <boxGeometry args={[coverBoardThickness, bookHeight, bodyDepth]} />
          <meshStandardMaterial
            color={book.color}
            roughness={0.56}
            metalness={0.04}
          />
        </mesh>

        <mesh
          position={[-bookThickness / 2 + coverBoardThickness / 2, 0, bodyCenterZ]}
          castShadow
          receiveShadow
        >
          <boxGeometry args={[coverBoardThickness, bookHeight, bodyDepth]} />
          <meshStandardMaterial
            color={book.color}
            roughness={0.56}
            metalness={0.04}
          />
        </mesh>

        <mesh
          geometry={spineGeometry}
          position={[0, 0, spineBaseZ]}
          castShadow
          receiveShadow
        >
          <meshStandardMaterial
            color={book.color}
            roughness={0.52}
            metalness={0.05}
          />
        </mesh>

        <mesh
          position={[bookThickness / 2 + 0.004, 0, bodyCenterZ]}
          rotation={[0, Math.PI / 2, 0]}
        >
          <planeGeometry args={[bodyDepth - 0.02, bookHeight - 0.02]} />
          <meshStandardMaterial
            map={coverTexture}
            roughness={0.55}
            metalness={0.04}
          />
        </mesh>

        <mesh
          position={[-0.008, 0.004, bodyCenterZ - 0.015]}
          castShadow
          receiveShadow
        >
          <boxGeometry args={[innerPageThickness, innerPageHeight, innerPageWidth]} />
          <meshStandardMaterial
            map={pagesTexture}
            roughness={0.9}
            metalness={0.0}
          />
        </mesh>

        <group position={[0, 0, spineLabelZ]}>
          <Text
            position={[0, spineTextY, 0.006]}
            rotation={[0, 0, Math.PI / 2]}
            font={book.fontUrl}
            fontSize={spineFontSize}
            maxWidth={spineMaxWidth}
            color={book.accentColor}
            anchorX="center"
            anchorY="middle"
          >
            {book.spineTitle}
          </Text>
        </group>

        <group position={[bookThickness / 2 + 0.012, 0, bodyCenterZ]} rotation={[0, Math.PI / 2, 0]}>
          <Text
            position={[0, coverTitleY, 0.006]}
            font={book.fontUrl}
            fontSize={book.fontStyle === 'serif' ? 0.28 : 0.23}
            maxWidth={bodyDepth * 0.8}
            color={book.accentColor}
            anchorX="center"
            anchorY="middle"
            textAlign="center"
          >
            {book.coverTitle}
          </Text>

          <Text
            position={[0, coverSubtitleY, 0.006]}
            font="/fonts/asta-sans.ttf"
            fontSize={0.072}
            maxWidth={bodyDepth * 0.76}
            color={book.accentColor}
            anchorX="center"
            anchorY="middle"
            textAlign="center"
          >
            {book.coverSubtitle}
          </Text>
        </group>
      </animated.group>
    </group>
  );
}
